NODE_ENV=development
PORT=3000

DATABASE_URL="mysql://usai:usai@localhost:3306/usai"

# Segredos dos tokens de login. Em desenvolvimento podem ficar vazios (usa valores padrão, só para a sua máquina).
# Em PRODUÇÃO são obrigatórios: dois valores DIFERENTES, aleatórios, com 32 caracteres ou mais; sem eles o servidor
# não sobe. Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Em produção: URL do front que pode chamar a API, separadas por vírgula (obrigatório em produção).
# Exemplo: CORS_ORIGINS=https://app.seudominio.com.br
CORS_ORIGINS=

# Quantos proxies (nginx, balanceador) ficam entre a internet e a API. Sem isso o IP de quem chama aparece errado
# e os limites de tentativas (login, PIN) passam a valer para todo mundo junto. Use o NÚMERO (ex.: 1), nunca true.
TRUST_PROXY=

# A chave do Asaas começa com $: deixe entre aspas simples ('$aact_...'). Sem as aspas, o docker compose
# trata o $ como variável e a chave chega vazia no contêiner.
ASAAS_API_KEY=''
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

FRONTEND_URL=http://localhost:5173

# E-mail (acesso do síndico após o PIX). Sem SMTP_HOST o e-mail não sai: o conteúdo vai pro log do servidor.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=seu@gmail.com e SMTP_PASS=<senha de app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="USAI <nao-responda@usai.com.br>"
# Opcional: endereço que recebe as respostas dos e-mails (ex.: contato@usai.com.br)
MAIL_REPLY_TO=
# Endereço público do frontend, usado nos links dos e-mails
APP_URL=http://localhost:5173

# Plano de teste de R$ 5,00 (o mínimo que o Asaas aceita; valida a cobrança por PIX, ex.: conta em produção).
# Deixe false: ligue só durante o teste e desligue depois, senão qualquer visitante pode contratá-lo.
PLANO_TESTE_ATIVO=false
