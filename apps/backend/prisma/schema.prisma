generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Papel {
  MORADOR
  SINDICO
  ADMIN
}

enum StatusLocacao {
  PENDENTE
  APROVADA
  PAGA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum StatusSaque {
  PENDENTE
  APROVADO
  REJEITADO
}

enum StatusPost {
  ABERTO
  ATENDIDO
}

enum TipoPost {
  PEDIDO
  AVISO
}

model Condominio {
  id        String   @id @default(uuid())
  nome      String
  linkSlug  String   @unique
  pin       String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios          User[]
  itens             Item[]
  posts             Post[]
  conversasPrivadas ConversaPrivada[]

  @@map("condominios")
}

model User {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String
  cpf          String?  @unique
  papel        Papel    @default(MORADOR)
  apartamento  String?
  chavePix     String?
  condominioId String?
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  condominio            Condominio?        @relation(fields: [condominioId], references: [id])
  itens                 Item[]
  locacoesComoLocatario Locacao[]          @relation("Locatario")
  mensagens             Mensagem[]
  solicitacoesSaque     SolicitacaoSaque[]
  logsAuditoria         LogAuditoria[]
  posts                 Post[]
  comentariosPost       ComentarioPost[]
  conversasComoA        ConversaPrivada[]  @relation("ConversaParticipanteA")
  conversasComoB        ConversaPrivada[]  @relation("ConversaParticipanteB")
  mensagensPrivadas     MensagemPrivada[]

  @@index([condominioId])
  @@map("users")
}

model Item {
  id           String   @id @default(uuid())
  titulo       String
  descricao    String   @db.Text
  categoria    String
  valorDiaria  Decimal  @db.Decimal(10, 2)
  ativo        Boolean  @default(true)
  ownerId      String
  condominioId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner      User         @relation(fields: [ownerId], references: [id])
  condominio Condominio   @relation(fields: [condominioId], references: [id])
  imagens    ItemImagem[]
  locacoes   Locacao[]

  @@index([condominioId])
  @@index([ownerId])
  @@map("itens")
}

model ItemImagem {
  id     String @id @default(uuid())
  itemId String
  url    String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_imagens")
}

model Locacao {
  id          String        @id @default(uuid())
  itemId      String
  locatarioId String
  dataInicio  DateTime
  dataFim     DateTime
  valorTotal  Decimal       @db.Decimal(10, 2)
  status      StatusLocacao @default(PENDENTE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  item      Item       @relation(fields: [itemId], references: [id])
  locatario User       @relation("Locatario", fields: [locatarioId], references: [id])
  pagamento Pagamento?
  mensagens Mensagem[]

  @@index([itemId])
  @@index([locatarioId])
  @@map("locacoes")
}

model Pagamento {
  id            String    @id @default(uuid())
  locacaoId     String    @unique
  asaasChargeId String?   @unique
  status        String    @default("PENDENTE")
  valor         Decimal   @db.Decimal(10, 2)
  pagoEm        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  locacao Locacao @relation(fields: [locacaoId], references: [id])

  @@map("pagamentos")
}

model Mensagem {
  id          String   @id @default(uuid())
  locacaoId   String
  remetenteId String
  conteudo    String   @db.Text
  createdAt   DateTime @default(now())

  locacao   Locacao @relation(fields: [locacaoId], references: [id])
  remetente User    @relation(fields: [remetenteId], references: [id])

  @@index([locacaoId])
  @@map("mensagens")
}

model SolicitacaoSaque {
  id             String      @id @default(uuid())
  userId         String
  valor          Decimal     @db.Decimal(10, 2)
  chavePixUsada  String
  status         StatusSaque @default(PENDENTE)
  motivoRejeicao String?
  createdAt      DateTime    @default(now())
  processadoEm   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("solicitacoes_saque")
}

model Post {
  id           String      @id @default(uuid())
  conteudo     String      @map("descricao") @db.Text
  tipo         TipoPost    @default(PEDIDO)
  categoria    String?
  status       StatusPost?
  autorId      String
  condominioId String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  autor           User              @relation(fields: [autorId], references: [id])
  condominio      Condominio        @relation(fields: [condominioId], references: [id])
  comentarios     ComentarioPost[]
  conversasOrigem ConversaPrivada[]

  @@index([condominioId])
  @@index([autorId])
  @@map("pedidos")
}

model ComentarioPost {
  id        String   @id @default(uuid())
  postId    String   @map("pedidoId")
  autorId   String
  conteudo  String   @db.Text
  createdAt DateTime @default(now())

  post  Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  autor User @relation(fields: [autorId], references: [id])

  @@index([postId])
  @@map("respostas_pedido")
}

/// Chat privado 1:1 aberto a partir do Mural (autor de um post ou de um comentário). Efêmero por
/// design: expira 7 dias depois de criado (`expiraEm`) e é apagado de vez — não reaproveita o
/// padrão do chat de locação (que dura o ciclo todo da locação).
model ConversaPrivada {
  id              String   @id @default(uuid())
  postOrigemId    String?
  participanteAId String
  participanteBId String
  condominioId    String
  createdAt       DateTime @default(now())
  expiraEm        DateTime

  postOrigem    Post?             @relation(fields: [postOrigemId], references: [id], onDelete: SetNull)
  participanteA User              @relation("ConversaParticipanteA", fields: [participanteAId], references: [id])
  participanteB User              @relation("ConversaParticipanteB", fields: [participanteBId], references: [id])
  condominio    Condominio        @relation(fields: [condominioId], references: [id])
  mensagens     MensagemPrivada[]

  @@index([condominioId])
  @@index([participanteAId])
  @@index([participanteBId])
  @@index([expiraEm])
  @@map("conversas_privadas")
}

model MensagemPrivada {
  id          String   @id @default(uuid())
  conversaId  String
  remetenteId String
  conteudo    String   @db.Text
  createdAt   DateTime @default(now())

  conversa  ConversaPrivada @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  remetente User            @relation(fields: [remetenteId], references: [id])

  @@index([conversaId])
  @@map("mensagens_privadas")
}

model LogAuditoria {
  id        String   @id @default(uuid())
  adminId   String
  acao      String
  alvoTipo  String
  alvoId    String
  metadata  Json?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@map("logs_auditoria")
}
