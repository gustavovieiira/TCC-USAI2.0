generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Papel {
  MORADOR
  SINDICO
  ADMIN
}

enum StatusLocacao {
  PENDENTE
  APROVADA
  PAGA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

/// PENDENTE → (Admin decide) APROVADO ou REJEITADO; APROVADO → (Admin transfere o PIX) PAGO.
enum StatusSaque {
  PENDENTE
  APROVADO
  REJEITADO
  PAGO
}

enum StatusPost {
  ABERTO
  ATENDIDO
}

enum TipoPost {
  PEDIDO
  AVISO
}

model Condominio {
  id        String   @id @default(uuid())
  nome      String
  linkSlug  String   @unique
  pin       String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios          User[]
  itens             Item[]
  posts             Post[]
  conversasPrivadas ConversaPrivada[]

  @@map("condominios")
}

model User {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String
  cpf             String?  @unique
  asaasCustomerId String?  @unique
  papel           Papel    @default(MORADOR)
  apartamento     String?
  chavePix        String?
  condominioId    String?
  ativo           Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  condominio            Condominio?        @relation(fields: [condominioId], references: [id])
  itens                 Item[]
  locacoesComoLocatario Locacao[]          @relation("Locatario")
  solicitacoesSaque     SolicitacaoSaque[]
  logsAuditoria         LogAuditoria[]
  posts                 Post[]
  comentariosPost       ComentarioPost[]
  conversasComoA        ConversaPrivada[]  @relation("ConversaParticipanteA")
  conversasComoB        ConversaPrivada[]  @relation("ConversaParticipanteB")
  mensagensPrivadas     MensagemPrivada[]
  notificacoes          Notificacao[]
  lancamentos           Lancamento[]
  movimentacoesEntregues Movimentacao[] @relation("MovimentacaoEntregue")
  movimentacoesRecebidas Movimentacao[] @relation("MovimentacaoRecebida")
  aceitesTermo          AceiteTermo[]
  eventosMovimentacao   EventoMovimentacao[]

  @@index([condominioId])
  @@map("users")
}

model Item {
  id           String   @id @default(uuid())
  titulo       String
  descricao    String   @db.Text
  categoria    String
  valorDiaria  Decimal  @db.Decimal(10, 2)
  /// Identificação do bem, opcionais: o que o dono souber informar (ex.: furadeira Bosch GSB 13 RE).
  fabricante   String?  @db.VarChar(120)
  modelo       String?  @db.VarChar(120)
  numeroSerie  String?  @db.VarChar(120)
  /// Lista de acessórios que acompanham o item (string[]), conferida na retirada e na devolução.
  acessorios   Json?
  ativo        Boolean  @default(true)
  ownerId      String
  condominioId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner      User         @relation(fields: [ownerId], references: [id])
  condominio Condominio   @relation(fields: [condominioId], references: [id])
  imagens    ItemImagem[]
  locacoes   Locacao[]

  @@index([condominioId])
  @@index([ownerId])
  @@map("itens")
}

model ItemImagem {
  id     String @id @default(uuid())
  itemId String
  url    String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_imagens")
}

model Locacao {
  id          String        @id @default(uuid())
  itemId      String
  locatarioId String
  dataInicio  DateTime
  dataFim     DateTime
  valorTotal  Decimal       @db.Decimal(10, 2)
  /// Para que o locatário vai usar o item (informado no pedido).
  finalidade  String?       @db.Text
  /// Preenchidos quando o pagamento é confirmado (M3): a taxa da plataforma e o que o dono recebe,
  /// gravados pra o histórico e o extrato não mudarem se a taxa mudar um dia.
  taxaPlataforma Decimal?   @db.Decimal(10, 2)
  valorLiquido   Decimal?   @db.Decimal(10, 2)
  status      StatusLocacao @default(PENDENTE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  item      Item       @relation(fields: [itemId], references: [id])
  locatario User       @relation("Locatario", fields: [locatarioId], references: [id])
  pagamento Pagamento?
  lancamentos Lancamento[]
  movimentacoes Movimentacao[]
  conversa  ConversaPrivada?

  @@index([itemId])
  @@index([locatarioId])
  @@map("locacoes")
}

model Pagamento {
  id            String    @id @default(uuid())
  locacaoId     String    @unique
  asaasChargeId String?   @unique
  invoiceUrl    String?
  status        String    @default("PENDENTE")
  valor         Decimal   @db.Decimal(10, 2)
  pagoEm        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  locacao Locacao @relation(fields: [locacaoId], references: [id])

  @@map("pagamentos")
}

model SolicitacaoSaque {
  id             String      @id @default(uuid())
  userId         String
  valor          Decimal     @db.Decimal(10, 2)
  chavePixUsada  String
  status         StatusSaque @default(PENDENTE)
  motivoRejeicao String?
  createdAt      DateTime    @default(now())
  processadoEm   DateTime?
  /// Quando o Admin confirmou que o PIX foi transferido (status PAGO).
  pagoEm         DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("solicitacoes_saque")
}

model Post {
  id           String      @id @default(uuid())
  conteudo     String      @map("descricao") @db.Text
  tipo         TipoPost    @default(PEDIDO)
  categoria    String?
  status       StatusPost?
  autorId      String
  condominioId String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  autor           User              @relation(fields: [autorId], references: [id])
  condominio      Condominio        @relation(fields: [condominioId], references: [id])
  comentarios     ComentarioPost[]
  conversasOrigem ConversaPrivada[]

  @@index([condominioId])
  @@index([autorId])
  @@map("pedidos")
}

model ComentarioPost {
  id        String   @id @default(uuid())
  postId    String   @map("pedidoId")
  autorId   String
  conteudo  String   @db.Text
  createdAt DateTime @default(now())

  post  Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  autor User @relation(fields: [autorId], references: [id])

  @@index([postId])
  @@map("respostas_pedido")
}

/// Chat privado 1:1 aberto a partir do Mural (autor de um post ou de um comentário). Efêmero por
/// design: expira 7 dias depois de criado (`expiraEm`) e é apagado de vez — não reaproveita o
/// padrão do chat de locação (que dura o ciclo todo da locação).
/// Chat 1:1. Dois tipos: conversa aberta no Mural (efêmera, `expiraEm` = 7 dias) e o chat de uma
/// locação (`locacaoId` preenchido, sem expiração — dura enquanto a locação existir). Participante A
/// é quem abriu; no chat da locação, A = locatário e B = dono do item.
model ConversaPrivada {
  id                  String    @id @default(uuid())
  postOrigemId        String?
  locacaoId           String?   @unique
  participanteAId     String
  participanteBId     String
  condominioId        String
  createdAt           DateTime  @default(now())
  expiraEm            DateTime?
  /// Até quando cada participante já leu (não lidas = mensagens do outro depois disso).
  participanteALidoEm DateTime?
  participanteBLidoEm DateTime?

  postOrigem    Post?             @relation(fields: [postOrigemId], references: [id], onDelete: SetNull)
  locacao       Locacao?          @relation(fields: [locacaoId], references: [id])
  participanteA User              @relation("ConversaParticipanteA", fields: [participanteAId], references: [id])
  participanteB User              @relation("ConversaParticipanteB", fields: [participanteBId], references: [id])
  condominio    Condominio        @relation(fields: [condominioId], references: [id])
  mensagens     MensagemPrivada[]

  @@index([condominioId])
  @@index([participanteAId])
  @@index([participanteBId])
  @@index([expiraEm])
  @@map("conversas_privadas")
}

model MensagemPrivada {
  id          String   @id @default(uuid())
  conversaId  String
  remetenteId String
  conteudo    String   @db.Text
  createdAt   DateTime @default(now())

  conversa  ConversaPrivada @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  remetente User            @relation(fields: [remetenteId], references: [id])

  @@index([conversaId])
  @@map("mensagens_privadas")
}

model LogAuditoria {
  id        String   @id @default(uuid())
  adminId   String
  acao      String
  alvoTipo  String
  alvoId    String
  metadata  Json?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@map("logs_auditoria")
}

/// Aviso persistido pra um usuário (sino + página de notificações). Criado pelos services quando
/// algo acontece que a pessoa precisa saber (pedido de locação, pagamento, saque...). `tipo` é uma
/// das strings de `TipoNotificacao` em `notificacoes.types.ts`; `link` é a rota do front pra abrir.
model Notificacao {
  id        String   @id @default(uuid())
  userId    String
  tipo      String
  titulo    String
  mensagem  String   @db.Text
  link      String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lida, createdAt])
  @@map("notificacoes")
}

/// Livro-razão: cada centavo que entra numa conta (ou é só registrado como informativo) vira um
/// lançamento imutável, com a origem (locação), a base de cálculo e a taxa aplicada. O saldo
/// sacável de alguém = soma dos lançamentos com `afetaSaldo` menos os saques; o extrato detalhado
/// (do próprio usuário e, pro Admin, de qualquer um) é montado daqui. `userId` nulo = conta da USAI.
///
/// Tipos: ALUGUEL_RECEBIDO (dono, valor líquido), COMISSAO_CONDOMINIO (síndico, fatia dos 10%),
/// TAXA_PLATAFORMA (USAI — condomínio sem síndico, ou aluguéis anteriores à comissão do síndico),
/// ALUGUEL_PAGO (locatário, informativo: não mexe no saldo).
model Lancamento {
  id             String   @id @default(uuid())
  userId         String?
  tipo           String
  /// Sempre positivo; o tipo diz se é entrada ou só informativo.
  valor          Decimal  @db.Decimal(10, 2)
  afetaSaldo     Boolean  @default(true)
  locacaoId      String?
  condominioId   String?
  /// Valor sobre o qual a taxa incidiu (o aluguel pago) e o percentual aplicado.
  baseCalculo    Decimal? @db.Decimal(10, 2)
  taxaPercentual Decimal? @db.Decimal(5, 2)
  /// Em quantos síndicos a comissão foi dividida.
  divididoEntre  Int?
  descricao      String
  createdAt      DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  locacao Locacao? @relation(fields: [locacaoId], references: [id])

  @@index([userId, createdAt])
  @@index([locacaoId])
  @@index([tipo])
  @@map("lancamentos")
}

/// Configurações da plataforma editáveis pelo Admin (logo oficial, nome e rodapé institucionais).
model Configuracao {
  chave          String   @id @db.VarChar(64)
  valor          String   @db.Text
  atualizadoPorId String?
  updatedAt      DateTime @updatedAt

  @@map("configuracoes")
}

enum TipoMovimentacao {
  RETIRADA
  DEVOLUCAO
}

enum StatusMovimentacao {
  AGUARDANDO_ACEITE
  CONCLUIDA
  CANCELADA
}

enum EstadoConservacao {
  OTIMO
  BOM
  REGULAR
  COM_AVARIAS
}

/// Texto do termo de responsabilidade de um tipo de operação. Cada alteração cria uma NOVA versão
/// (as anteriores nunca mudam — os aceites já dados apontam pra elas). `statusRevisao` deixa claro
/// que o texto é um modelo até a empresa/condomínio aprovar; a USAI não o apresenta como validado
/// juridicamente antes disso.
model TermoResponsabilidade {
  id           String           @id @default(uuid())
  tipo         TipoMovimentacao
  versao       Int
  titulo       String
  /// string[] — cláusulas, em ordem.
  clausulas    Json
  /// { id, texto }[] — declarações que o usuário precisa marcar (todas obrigatórias).
  declaracoes  Json
  /// MODELO (pendente de revisão) ou APROVADO.
  statusRevisao String          @default("MODELO")
  aprovadoPorId String?
  aprovadoEm   DateTime?
  criadoPorId  String?
  createdAt    DateTime         @default(now())

  movimentacoes Movimentacao[]
  aceites       AceiteTermo[]

  @@unique([tipo, versao])
  @@map("termos_responsabilidade")
}

/// Retirada (dono entrega, locatário recebe) ou devolução (locatário entrega, dono recebe) de um
/// item numa locação. Quem entrega registra; quem recebe confere e aceita o termo. Concluída, não
/// muda mais: correções entram como eventos (`EventoMovimentacao`) e a integridade é verificável
/// pelo `hashIntegridade`.
model Movimentacao {
  id              String             @id @default(uuid())
  /// Número sequencial do documento (exibido como USAI-AAAA-000123).
  numero          Int                @unique @default(autoincrement())
  locacaoId       String
  tipo            TipoMovimentacao
  status          StatusMovimentacao @default(AGUARDANDO_ACEITE)
  entreguePorId   String
  recebidoPorId   String
  ocorridoEm      DateTime
  estadoConservacao EstadoConservacao
  /// { nome, conferido }[] — acessórios relacionados e se acompanham a operação.
  acessorios      Json
  observacoes     String?            @db.Text
  termoId         String
  /// Foto dos dados do documento no momento do registro (partes, item, locação) — o documento
  /// continua igual mesmo que o item ou o perfil mudem depois.
  snapshot        Json
  hashIntegridade String?            @db.VarChar(64)
  concluidaEm     DateTime?
  createdAt       DateTime           @default(now())

  locacao     Locacao               @relation(fields: [locacaoId], references: [id])
  entreguePor User                  @relation("MovimentacaoEntregue", fields: [entreguePorId], references: [id])
  recebidoPor User                  @relation("MovimentacaoRecebida", fields: [recebidoPorId], references: [id])
  termo       TermoResponsabilidade @relation(fields: [termoId], references: [id])
  aceites     AceiteTermo[]
  eventos     EventoMovimentacao[]

  @@index([locacaoId])
  @@index([entreguePorId])
  @@index([recebidoPorId])
  @@map("movimentacoes")
}

/// Aceite expresso do termo por quem recebeu: declarações marcadas (texto congelado), versão do
/// termo, data/hora, e uma assinatura eletrônica simples (senha reconfirmada + impressão digital
/// SHA-256 do aceite). IP e navegador ficam registrados pra rastreabilidade.
model AceiteTermo {
  id            String   @id @default(uuid())
  movimentacaoId String
  userId        String
  termoId       String
  /// { id, texto }[] — o texto exato que foi marcado.
  declaracoes   Json
  aceitoEm      DateTime @default(now())
  ip            String?  @db.VarChar(64)
  userAgent     String?  @db.VarChar(255)
  assinatura    String   @db.VarChar(64)

  movimentacao Movimentacao          @relation(fields: [movimentacaoId], references: [id])
  user         User                  @relation(fields: [userId], references: [id])
  termo        TermoResponsabilidade @relation(fields: [termoId], references: [id])

  @@unique([movimentacaoId, userId])
  @@map("aceites_termo")
}

/// Histórico (só acrescenta, nunca altera): criação, aceite, cancelamento e retificações.
model EventoMovimentacao {
  id             String   @id @default(uuid())
  movimentacaoId String
  userId         String
  acao           String   @db.VarChar(40)
  detalhe        String?  @db.Text
  createdAt      DateTime @default(now())

  movimentacao Movimentacao @relation(fields: [movimentacaoId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([movimentacaoId, createdAt])
  @@map("eventos_movimentacao")
}
