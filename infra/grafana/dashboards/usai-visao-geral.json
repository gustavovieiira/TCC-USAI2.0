      },
      "description": "Em azul, tudo que a API recebeu; em vermelho, o que deu erro 5xx. As duas linhas sobem juntas quando há muito uso; só a vermelha subir indica problema.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_count[1m])) * 60",
