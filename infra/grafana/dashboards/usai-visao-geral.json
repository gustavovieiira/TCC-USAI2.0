    {
      "id": 18,
      "type": "bargauge",
      "title": "Memória de cada contêiner (% do limite)",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 9
      },
      "description": "Cada contêiner tem um teto de memória. A barra mostra quanto do teto está em uso. Perto de 100% o contêiner pode ser reiniciado pelo sistema (o Grafana, por exemplo, usa bastante).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * container_memory_working_set_bytes{name!=\"\"} / (container_spec_memory_limit_bytes{name!=\"\"} > 0)",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
