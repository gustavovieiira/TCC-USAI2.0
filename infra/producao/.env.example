# Modelo do `.env` de produção. No servidor ele fica em /opt/usai/infra/producao/.env (nunca vai para o Git).
# Valores entre aspas simples: o docker compose trata `$` como variável, e chaves como a do Asaas começam com `$`.

DOMAIN=usainet.com.br
ACME_EMAIL=usaisuporte@gmail.com

# Gere cada segredo com: openssl rand -hex 32   (os dois do JWT precisam ser DIFERENTES, com 32+ caracteres)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GRAFANA_ADMIN_PASSWORD=

# Escrito pelo deploy automático: a versão (commit) das imagens em uso. Para voltar uma versão, troque e rode
# `docker compose up -d`.
USAI_TAG=latest

# Asaas. Sandbox: https://api-sandbox.asaas.com/v3  |  Produção: https://api.asaas.com/v3
ASAAS_API_KEY=''
ASAAS_WEBHOOK_TOKEN=''
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Plano de teste de R$ 5,00: ligue só durante o teste de produção.
PLANO_TESTE_ATIVO=false

# E-mail (acesso do síndico após o pagamento). Sem SMTP_HOST o e-mail não sai: vai para o log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=''
MAIL_FROM="USAI <nao-responda@usainet.com.br>"
MAIL_REPLY_TO=
